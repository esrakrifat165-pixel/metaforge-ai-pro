/* Top bar search. Every class starts with "sb-". Uses the app's theme variables. */

.sb-root {
  position: relative;
  flex: 1;
  min-width: 0;
  max-width: 460px;
}

.sb-icon {
  position: absolute;
  top: 50%;
  left: 12px;
  transform: translateY(-50%);
  color: var(--text-muted);
  pointer-events: none;
}

.sb-input {
  width: 100%;
  padding: 10px 12px 10px 36px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  font-size: 0.9rem;
}

.sb-input:focus-visible {
  outline: 2px solid var(--accent-text);
  outline-offset: 1px;
}

.sb-list {
  position: absolute;
  z-index: 40;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  display: grid;
  margin: 0;
  padding: 6px;
  list-style: none;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
}

.sb-option {
  display: grid;
  gap: 2px;
  padding: 9px 10px;
  border-radius: 8px;
  cursor: pointer;
}

.sb-option[aria-selected="true"] {
  background: var(--surface-hover);
}

.sb-option small {
  color: var(--text-muted);
  font-size: 0.76rem;
}

.sb-empty {
  padding: 10px;
  color: var(--text-muted);
  font-size: 0.85rem;
}
