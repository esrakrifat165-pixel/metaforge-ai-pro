/* METAFORGE-BGREMOVER v1 - scoped styles for the Background Remover workspace.
   Colors are neutral overlays on whatever theme the app uses, so dark and light both work.
   Change --bgr-accent below to match your brand color. */

.root {
  --bgr-accent: #7c5cff;
  --bgr-line: rgba(127, 127, 127, 0.32);
  --bgr-fill: rgba(127, 127, 127, 0.09);
  --bgr-fill-strong: rgba(127, 127, 127, 0.18);
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  color: inherit;
}

.pageHeader {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.pageTitle {
  margin: 0;
  font-size: 1.75rem;
  line-height: 1.2;
}

.pageLead {
  margin: 0;
  max-width: 75ch;
  opacity: 0.8;
  line-height: 1.5;
}

/* ---------- buttons ---------- */

.btn {
  appearance: none;
  border: 1px solid var(--bgr-line);
  background: var(--bgr-fill-strong);
  color: inherit;
  padding: 0.55rem 0.95rem;
  border-radius: 10px;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  line-height: 1.2;
}

.btn:hover:not(:disabled) {
  background: rgba(127, 127, 127, 0.3);
}

.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.btn:focus-visible,
.segBtn:focus-visible,
.titleBtn:focus-visible {
  outline: 2px solid var(--bgr-accent);
  outline-offset: 2px;
}

.btnPrimary {
  background: var(--bgr-accent);
  border-color: var(--bgr-accent);
  color: #ffffff;
}

.btnPrimary:hover:not(:disabled) {
  background: var(--bgr-accent);
  filter: brightness(1.1);
}

/* ---------- drop zone ---------- */

.dropzone {
  border: 2px dashed var(--bgr-line);
  background: var(--bgr-fill);
  border-radius: 16px;
  padding: 2rem 1.25rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  text-align: center;
}

.dropzoneActive {
  border-color: var(--bgr-accent);
  background: rgba(124, 92, 255, 0.14);
}

.dropTitle {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 700;
}

.dropHint {
  margin: 0;
  opacity: 0.75;
  max-width: 70ch;
  line-height: 1.5;
}

/* ---------- notices ---------- */

.notices {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.notice {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem;
  border-radius: 10px;
  border: 1px solid var(--bgr-line);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.noticeError {
  background: rgba(239, 68, 68, 0.14);
  border-color: rgba(239, 68, 68, 0.5);
}

.noticeInfo {
  background: rgba(59, 130, 246, 0.14);
  border-color: rgba(59, 130, 246, 0.5);
}

.noticeClose {
  appearance: none;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
  opacity: 0.7;
}

.noticeClose:hover {
  opacity: 1;
}

/* ---------- settings ---------- */

.settings {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
}

.settingGroup {
  border: 1px solid var(--bgr-line);
  background: var(--bgr-fill);
  border-radius: 14px;
  padding: 0.9rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.settingLabel {
  font-weight: 700;
}

.settingHint {
  margin: 0;
  opacity: 0.75;
  font-size: 0.9rem;
  line-height: 1.45;
}

.seg {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  align-items: center;
}

.segBtn {
  appearance: none;
  border: 1px solid var(--bgr-line);
  background: transparent;
  color: inherit;
  padding: 0.4rem 0.8rem;
  border-radius: 999px;
  font: inherit;
  cursor: pointer;
}

.segBtn:hover {
  background: var(--bgr-fill-strong);
}

.segBtnActive {
  background: var(--bgr-accent);
  border-color: var(--bgr-accent);
  color: #ffffff;
}

.colorInput {
  width: 2.5rem;
  height: 2rem;
  padding: 0;
  border: 1px solid var(--bgr-line);
  border-radius: 8px;
  background: transparent;
  cursor: pointer;
}

/* ---------- controls ---------- */

.controls {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.controlButtons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.chips {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.chip {
  border: 1px solid var(--bgr-line);
  background: var(--bgr-fill);
  border-radius: 999px;
  padding: 0.25rem 0.7rem;
  font-size: 0.9rem;
}

.empty {
  margin: 0;
  padding: 2rem 1rem;
  text-align: center;
  opacity: 0.7;
  border: 1px dashed var(--bgr-line);
  border-radius: 14px;
}

/* ---------- result rows ---------- */

.rows {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.row {
  border: 1px solid var(--bgr-line);
  background: var(--bgr-fill);
  border-radius: 16px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.rowSelected {
  border-color: var(--bgr-accent);
  box-shadow: 0 0 0 1px var(--bgr-accent);
}

.rowHeader {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
}

.rowTitleWrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-width: 0;
  flex: 1 1 260px;
}

.rowTitle {
  margin: 0;
  font-size: 1.1rem;
  min-width: 0;
}

.titleBtn {
  appearance: none;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  font-weight: 700;
  padding: 0;
  cursor: pointer;
  text-align: left;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.rowActions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.rowMeta {
  margin: 0;
  opacity: 0.8;
  font-size: 0.92rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.warn {
  margin: 0;
  padding: 0.5rem 0.75rem;
  border-radius: 10px;
  border: 1px solid rgba(245, 158, 11, 0.55);
  background: rgba(245, 158, 11, 0.14);
}

.badge {
  flex: none;
  border: 1px solid var(--bgr-line);
  border-radius: 999px;
  padding: 0.15rem 0.65rem;
  font-size: 0.85rem;
  font-weight: 600;
}

.badgeReady {
  background: var(--bgr-fill-strong);
}

.badgeQueued {
  background: rgba(245, 158, 11, 0.2);
  border-color: rgba(245, 158, 11, 0.55);
}

.badgeProcessing {
  background: rgba(59, 130, 246, 0.2);
  border-color: rgba(59, 130, 246, 0.55);
}

.badgeDone {
  background: rgba(34, 197, 94, 0.2);
  border-color: rgba(34, 197, 94, 0.55);
}

.badgeFailed {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.55);
}

.panels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.panelBox {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  min-width: 0;
}

.panelLabel {
  font-weight: 600;
  font-size: 0.9rem;
  opacity: 0.85;
}

.panelBody {
  position: relative;
  height: clamp(280px, 50vh, 560px);
  border: 1px solid var(--bgr-line);
  border-radius: 12px;
  overflow: hidden;
  background: var(--bgr-fill);
}

.imgLayer {
  position: absolute;
  inset: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem;
  text-align: center;
  overflow: auto;
}

.placeholder p {
  margin: 0;
  overflow-wrap: anywhere;
}

.dim {
  opacity: 0.65;
  font-size: 0.9rem;
}

.errorText {
  color: #ef4444;
  font-weight: 600;
}

/* Preview-only checkerboard. It is a CSS background and is never part of the exported PNG. */
.checker {
  background-color: #ffffff;
  background-image:
    linear-gradient(45deg, #d4d4d4 25%, transparent 25%),
    linear-gradient(-45deg, #d4d4d4 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #d4d4d4 75%),
    linear-gradient(-45deg, transparent 75%, #d4d4d4 75%);
  background-size: 20px 20px;
  background-position: 0 0, 0 10px, 10px -10px, -10px 0;
}

/* ---------- inspector modal ---------- */

.modalBackdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.modal {
  background: #ffffff;
  color: #111827;
  width: min(1200px, 100%);
  max-height: 100%;
  border-radius: 16px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

:global(.dark) .modal,
:global([data-theme="dark"]) .modal {
  background: #161a22;
  color: #eef1f6;
}

.modalHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}

.modalTitle {
  margin: 0;
  font-size: 1.1rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modalToolbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
}

.sliderLabel {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex: 1 1 260px;
  max-width: 480px;
}

.sliderLabel input {
  flex: 1;
}

.modalViewport {
  overflow: auto;
  max-height: 68vh;
  border: 1px solid var(--bgr-line, rgba(127, 127, 127, 0.32));
  border-radius: 12px;
}

.stage {
  position: relative;
  max-width: none;
}

.layer {
  position: absolute;
  inset: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2px;
  margin-left: -1px;
  background: #7c5cff;
  pointer-events: none;
}

.modalNote {
  margin: 0;
  opacity: 0.75;
  font-size: 0.9rem;
}

/* ---------- responsive ---------- */

@media (max-width: 760px) {
  .panels {
    grid-template-columns: 1fr;
  }

  .panelBody {
    height: clamp(240px, 45vh, 420px);
  }

  .pageTitle {
    font-size: 1.4rem;
  }
}