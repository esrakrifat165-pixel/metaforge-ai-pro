// Strict metadata rules: title <= 70 chars, one-sentence description <= 180 chars,
// exactly `count` unique keywords (count comes from the UI and platform rules).

export const STRICT_LIMITS = { titleMax: 70, descriptionMax: 180 } as const;

export type StrictData = { title: string; description: string; keywords: string[] };

export type StrictValidation =
  | { ok: true; data: StrictData; warnings: string[] }
  | { ok: false; problems: string[] };

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

export function cleanKeyword(raw: string): string {
  return raw
    .replace(/^\s*(?:[-*\u2022]|\d+[.)])\s*/, "")
    .replace(/^["'`]+|["'`]+$/g, "")
    .replace(/[.;:]+$/, "")
    .replace(/\s+/g, " ")
    .trim();
}

export function normalizeKeywords(value: unknown): string[] {
  const parts: string[] = Array.isArray(value)
    ? value.filter((item): item is string => typeof item === "string")
    : typeof value === "string"
      ? value.split(",")
      : [];

  const seen = new Set<string>();
  const result: string[] = [];
  for (const part of parts) {
    const keyword = cleanKeyword(part);
    if (keyword.length === 0 || keyword.length > 60) {
      continue;
    }
    const key = keyword.toLocaleLowerCase("en").replace(/[^\p{L}\p{N}]/gu, "");
    if (seen.has(key)) {
      continue;
    }
    seen.add(key);
    result.push(keyword);
  }
  return result;
}

function cleanText(value: unknown, label: string): string {
  if (typeof value !== "string") {
    return "";
  }
  const withoutLabel = value.replace(new RegExp(`^\\s*${label}\\s*:\\s*`, "i"), "");
  return withoutLabel.replace(/^["'`]+|["'`]+$/g, "").replace(/\s+/g, " ").trim();
}

function sentenceCount(text: string): number {
  return text.split(/[.!?]+\s+/).filter((part) => part.trim().length > 0).length;
}

export function validateStrict(raw: unknown, count: number): StrictValidation {
  if (!isRecord(raw)) {
    return { ok: false, problems: ["The response was not a JSON object."] };
  }

  const problems: string[] = [];
  const warnings: string[] = [];

  const title = cleanText(raw.title, "title");
  if (title.length === 0) {
    problems.push("The title is missing.");
  } else if (title.length > STRICT_LIMITS.titleMax) {
    problems.push(`The title is ${title.length} characters; the maximum is ${STRICT_LIMITS.titleMax}.`);
  }

  const description = cleanText(raw.description, "description");
  if (description.length === 0) {
    problems.push("The description is missing.");
  } else {
    if (description.length > STRICT_LIMITS.descriptionMax) {
      problems.push(
        `The description is ${description.length} characters; the maximum is ${STRICT_LIMITS.descriptionMax}.`,
      );
    }
    if (sentenceCount(description) !== 1) {
      problems.push("The description must be exactly one sentence.");
    }
    if (title.length > 0 && description.toLowerCase() === title.toLowerCase()) {
      problems.push("The description repeats the title.");
    }
  }

  let keywords = normalizeKeywords(raw.keywords);
  if (keywords.length < count) {
    problems.push(`Only ${keywords.length} unique keywords were returned; exactly ${count} are required.`);
  } else if (keywords.length > count) {
    keywords = keywords.slice(0, count);
    warnings.push(`Extra keywords were removed so exactly ${count} remain.`);
  }

  if (problems.length > 0) {
    return { ok: false, problems };
  }
  return { ok: true, data: { title, description, keywords }, warnings };
}

export function buildStrictSchema(count: number): Record<string, unknown> {
  return {
    type: "object",
    properties: {
      title: { type: "string", maxLength: STRICT_LIMITS.titleMax },
      description: { type: "string", maxLength: STRICT_LIMITS.descriptionMax },
      keywords: { type: "array", minItems: count, maxItems: count, items: { type: "string" } },
    },
    required: ["title", "description", "keywords"],
  };
}

export function buildStrictPrompt(count: number, problems: string[] = []): string {
  const lines = [
    "You are a professional stock-image metadata writer. Analyze the actual image supplied with this request, not its filename.",
    "",
    "VISUAL ANALYSIS — do this before writing metadata:",
    "- Identify the dominant subject, the number and type of visible subjects, their actions, and the objects they interact with.",
    "- Distinguish humans, children, animals, birds, objects, and symbols carefully. Never label people as birds or another subject.",
    "- For silhouette artwork, describe only shapes and activities that are actually visible. Do not infer identity, occupation, gender, relationships, pregnancy, or a specific activity without clear visual evidence.",
    "- If several related illustrations appear together, describe the collection and its clearly visible common theme.",
    "- Treat the filename as untrusted context; never let it override what the image shows.",
    "",
    "TITLE RULES:",
    "- Write one natural, specific, professional English stock title, no more than 70 characters including spaces.",
    "- Put the main visible subject first, followed by its distinctive action or feature when useful.",
    "- Prefer concrete wording such as 'Human Silhouettes of Walking People and Cyclists' when supported by the image.",
    "- Say 'set', 'collection', or 'bundle' only when multiple related items are visibly present.",
    "- Mention silhouette, vector, color, background, or composition only when supported by the image.",
    "- Avoid vague titles such as 'Different Activities' and avoid keyword-stuffed or promotional titles.",
    "",
    "DESCRIPTION RULES:",
    "- Write exactly ONE complete English sentence, at most 180 characters including spaces.",
    "- Describe the actual subject, visible actions, style, and background where relevant.",
    "- Do not repeat the title verbatim or invent details.",
    "",
    "KEYWORD RULES:",
    `- Return exactly ${count} unique, relevant English keywords.`,
    "- Order them by search importance: main subject, specific visible actions, related objects, subject attributes, illustration style, composition, and background.",
    "- Use specific multi-word phrases where they add useful meaning, such as 'human silhouettes', 'family group', or 'baby stroller', only when visually supported.",
    "- Avoid near-duplicates and redundant variants, such as using many forms of the same idea without adding meaning.",
    "- Do not pad the list with generic terms, unsupported activities, unrelated seasonal concepts, or speculative use cases.",
    "- Every keyword must be relevant to this particular image. Accuracy is more important than adding loosely related words.",
    "- Return keywords as an array of strings, not a comma-separated paragraph.",
    "",
    "OUTPUT:",
    "- Return only one valid JSON object with exactly these fields: title, description, keywords.",
    "- Do not include Markdown fences, explanations, or extra fields.",
  ];

  if (problems.length > 0) {
    lines.push(
      "",
      "The previous response failed validation. Correct every issue:",
      ...problems.map((problem) => `- ${problem}`),
      `Return exactly ${count} unique keywords and obey all title and description limits.`,
    );
  }

  return lines.join("\n");
}

